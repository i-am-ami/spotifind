{
  "name": "spotifind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth": "node backend/spotauth.js",
    "fetch:songs": "node backend/songs.js",
    "fetch:lyrics": "node backend/lyrics.js",
    "sync:library": "npm run fetch:songs && npm run fetch:lyrics",
    "serve:webapp": "python3 -m http.server 8000",
    "server": "node backend/server.js",
    "test:search": "node --test tests/search.test.js",
    "test:server": "node --test tests/server.test.js tests/server-errors.test.js tests/server-malformed-playlists.test.js",
    "test:lrclib": "node --test tests/lrclib.test.js",
    "test:search:log": "bash scripts/run-tests.sh search tests/search.test.js",
    "test:server:log": "bash scripts/run-tests.sh server tests/server.test.js tests/server-errors.test.js tests/server-malformed-playlists.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "open": "^10.1.0",
    "spotify-web-api-node": "^5.0.2"
  }
}
